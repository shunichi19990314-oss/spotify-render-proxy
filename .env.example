# ================= サーバ側 (Render の環境変数パネルに設定) =================
PORT=8080                                  # Render が自動で注入する。ローカル実行時のみ指定
PROXY_TOKEN=change-me-to-a-long-random     # ★必須。openssl rand -hex 24 で生成する
PUBLIC=0                                   # 1 = 認証なし(オープンプロキシ)。絶対に使わない
MAX_TUNNELS=50                             # 同時トンネル数の上限
CONNECT_TIMEOUT=10000                      # ターゲットへの TCP 接続タイムアウト (ms)
WEBPLAYER=1                                # 1 = Web Player リバースプロキシ(モードC)を有効化
VERBOSE=0                                  # 1 = プロキシのアクセスログを詳細にする

# ================= クライアント側 (手元PCの .env / 環境変数) =================
RENDER_URL=https://your-app-name.onrender.com
PROXY_TOKEN=change-me-to-a-long-random     # サーバと同じ値
LOCAL_HTTP_PORT=8888                       # ローカルに開く HTTP/HTTPS プロキシのポート
LOCAL_SOCKS_PORT=1080                      # ローカルに開く SOCKS5 プロキシのポート
MAX_CONCURRENT=16                          # ローカル側の同時トンネル数の上限
DISABLE_SOCKS=0                            # 1 で SOCKS5 リスナを無効化
HANDSHAKE_TIMEOUT=25000                    # トンネル確立の待ち時間 (ms)
